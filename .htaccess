# ===== Martin Barna — Apache konfigurace pro Wedos (statický web) =====
# Soubor je neškodný na GitHub Pages (ignoruje se) a aktivní na Wedos/Apache.

Options -Indexes
DirectoryIndex index.html

# --- 1) Vynuť HTTPS ---
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# --- 2) Sjednoť na NE-www (kanonická doména = martinbarna.cz) ---
# Tím se vyřeší i staré cache přesměrování na www: www teď 301 míří na apex,
# který obsah servíruje (žádná smyčka, žádný timeout).
RewriteCond %{HTTP_HOST} ^www\.martinbarna\.cz$ [NC]
RewriteRule ^ https://martinbarna.cz%{REQUEST_URI} [L,R=301]

# --- 2a) Case varianty oficiálních podstránek (mobilní auto-kapitalizace, např. /Koucing/) ---
# [NC] chytí libovolnou velikost písmen; RewriteCond vylučuje už-kanonický tvar (žádná smyčka).
RewriteCond %{REQUEST_URI} !^/koucing/$
RewriteRule ^koucing/?$ /koucing/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/akademie/$
RewriteRule ^akademie/?$ /akademie/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/start/$
RewriteRule ^start/?$ /start/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/reference/$
RewriteRule ^reference/?$ /reference/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/clanky/$
RewriteRule ^clanky/?$ /clanky/ [NC,R=301,L]
# Sloučení dvou článků o ultra-zpracovaných (1. 9. 2026, Martinovo GO):
RewriteRule ^clanky/ultra-zpracovane-potraviny-studie\.html$ /clanky/ultra-zpracovana-jidla.html [R=301,L]
RewriteCond %{REQUEST_URI} !^/makro-plan/$
RewriteRule ^makro-plan/?$ /makro-plan/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/forma-zpet/$
RewriteRule ^forma-zpet/?$ /forma-zpet/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/myty/$
RewriteRule ^myty/?$ /myty/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/prednasky/$
RewriteRule ^prednasky/?$ /prednasky/ [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/treninky$
RewriteRule ^treninky/?$ /treninky [NC,R=301,L]
RewriteCond %{REQUEST_URI} !^/videokurz$
RewriteRule ^videokurz/?$ /videokurz [NC,R=301,L]

# --- 2b) Čisté URL bez .html (sjednocení: /treninky a /videokurz jako ostatní podstránky) ---
# Staré odkazy s .html → 301 na čistou verzi (jen skutečné požadavky z prohlížeče,
# proto THE_REQUEST — vnitřní přepis níže se tím nespustí, žádná smyčka).
RewriteCond %{THE_REQUEST} \s/+treninky\.html[\s?] [NC]
RewriteRule ^ /treninky [R=301,L]
RewriteCond %{THE_REQUEST} \s/+videokurz\.html[\s?] [NC]
RewriteRule ^ /videokurz [R=301,L]
# Varianta s lomítkem → 301 na verzi bez lomítka (interní přepis by rozbil relativní assety).
RewriteRule ^treninky/$   /treninky   [R=301,L]
RewriteRule ^videokurz/$  /videokurz  [R=301,L]
# Čistou URL interně obsluž ze souboru (.html zůstává na disku, v adrese se neukáže).
RewriteRule ^treninky$   treninky.html   [L]
RewriteRule ^videokurz$  videokurz.html  [L]

# --- 2c) Zkratka pro TikTok bio: /tt → kvíz s tiktokovými UTM ---
# TikTok bio má limit 80 znaků a plná adresa kvízu s parametry jich má 82, takže se tam
# nevejde ani bez Martinova textu. Krátké martinbarna.cz/tt má 17 znaků a měření se
# dolepí až tady, takže neztrácíme atribuci.
# ⚠️ Schválně RewriteRule, a ne RedirectMatch jako sousední pravidla: cíl má VLASTNÍ query
#    string. mod_alias (Redirect/RedirectMatch) k cíli připojí i případný příchozí dotaz
#    a vyrobil by adresu se dvěma otazníky. mod_rewrite bez příznaku QSA příchozí dotaz
#    zahodí, takže cíl je vždycky čistý.
RewriteRule ^tt/?$ https://martinbarna.cz/kviz/?utm_source=tiktok&utm_medium=organic&utm_campaign=bio [NC,R=301,L]

# --- 3) Vlastní 404 stránka ---
ErrorDocument 404 /404.html

# --- 4) Přesměrování starých WordPress URL (parita, ať nic nespadne z Googlu) ---
# produktové/objednávkové stránky → vlastní prodejní stránky se ŽIVOU pokladnou
# ⛔ 13. 8. 2026: všech ŠEST těchto cest mířilo na SimpleShop a VŠECHNY byly MRTVÉ.
#    Každý formulář (qG2yO, 3Vbl, eVJ6, mMB7, xl6e, lQoO) vracel HTTP 200 se stránkou
#    „Produkt se již neprodává." ⇒ zákazník ze starého odkazu (bio na sítích, rozeslané
#    maily, staré příspěvky, PDF) nemohl koupit VŮBEC NIC a web přitom hlásil 200.
#    Ověřeno stažením všech šesti, ne odhadem. SimpleShop se zrušil, prodej jede přes Stripe.
# ⚠️ mod_alias k cíli připojí příchozí query string, takže utm parametry přežijí.
Redirect 301 /objednavka-konzultace/         https://martinbarna.cz/konzultace/
Redirect 301 /objednavka-videokurzu/         https://martinbarna.cz/videokurz
Redirect 301 /objednavka-ebooku/             https://martinbarna.cz/videokurz
Redirect 301 /objednavka-receptu/            https://martinbarna.cz/recepty-a-odpovedi/
Redirect 301 /clanky/doporuceni-bisglycinatu-horciku-pro-vas-aktivni-zivotni-styl-2.html https://martinbarna.cz/clanky/doporuceni-bisglycinatu-horciku-pro-vas-aktivni-zivotni-styl.html
Redirect 301 /objednavka-audiobooku/         https://martinbarna.cz/videokurz
# členská sekce jako PRODUKT zanikla (starý WP + SimpleShop). Nástupce placeného členství
# je Barna Academy, takže nákupní úmysl míří na její prodejní stránku, ne na přihlášení.
Redirect 301 /clenskasekce/objednavka/       https://martinbarna.cz/akademie/
Redirect 301 /martin/                        https://martinbarna.cz/#omne
Redirect 301 /muj-pribeh/                    https://martinbarna.cz/#omne
Redirect 301 /team-martin-barna/             https://martinbarna.cz/#omne
Redirect 301 /videokurz-dekovaci-stranka/    https://martinbarna.cz/videokurz
# kategorie blogu + starý /blog → nový blog
# Clanky zijí jako /clanky/nazev.html. Kdyz nekdo sdili nebo napise variantu s lomitkem
# (/clanky/nazev/), vracel web 404 a socialni site pak neukazaly ani nahled. Presmerujeme na .html.
RedirectMatch 301 (?i)^/clanky/([a-z0-9-]+)/$  https://martinbarna.cz/clanky/$1.html
RedirectMatch 301 ^/rubrika/.*$              https://martinbarna.cz/clanky/
RedirectMatch 301 ^/blog/?$                  https://martinbarna.cz/clanky/
# staré produktové stránky → videokurz (hlavní low-cost produkt, vše je v něm)
RedirectMatch 301 ^/ebook/?$                 https://martinbarna.cz/videokurz
RedirectMatch 301 ^/kucharka/?$              https://martinbarna.cz/videokurz
RedirectMatch 301 ^/recepty/?$               https://martinbarna.cz/videokurz
RedirectMatch 301 ^/audiobook/?$             https://martinbarna.cz/videokurz
RedirectMatch 301 ^/audiokniha/?$            https://martinbarna.cz/videokurz
# členská sekce = přihlášení existujících členů (odkaz žije na Linktree!), ne prodejní stránka
RedirectMatch 301 (?i)^/clenskasekce/?$      https://martinbarna.cz/akademie/prihlaseni/

# --- 4b) Záchranná síť: jazykové varianty a hádané tvary oficiálních stránek ---
# koučink: anglicky, spisovně, delší tvary → /koucing/ (kanonický slug už z WP éry, je na Linktree)
RedirectMatch 301 (?i)^/coaching(\.html)?/?$    https://martinbarna.cz/koucing/
RedirectMatch 301 (?i)^/koucink(\.html)?/?$     https://martinbarna.cz/koucing/
RedirectMatch 301 (?i)^/online-coaching/?$      https://martinbarna.cz/koucing/
RedirectMatch 301 (?i)^/online-koucink/?$       https://martinbarna.cz/koucing/
# /konzultace/ ma od 18. 7. VLASTNI prodejni stranku (od 30. 7. 2026 za 2 990 Kc, videokurz
# a e-booky v cene; balicek VIP zanikl), takze uz se nepresmerovava na koucink.
# Presmerovani drzime jen pro starou variantu s priponou .html.
RedirectMatch 301 (?i)^/konzultace\.html$  https://martinbarna.cz/konzultace/

# Dekovacka Academy ze doby SimpleShopu. Vsechny tri Stripe odkazy Academy dnes vedou na
# /akademie/vitejte/, a ta ma od 30. 7. 2026 i navod na vytvoreni uctu a pouceni o odstoupeni,
# takze je plnohodnotna nahrada. Interni odkazy na /dekuji-academy/ na webu zadne nejsou (grep).
# ⚠️ Mereni to neohrozi: `pageConv()` v analytics.js vraci na kazde /dekuji ceste null a
#    Purchase se posila server-side pres CAPI. Overeno, ne odhadnuto.
RedirectMatch 301 (?i)^/dekuji-academy/?$       https://martinbarna.cz/akademie/vitejte/
# Academy anglicky, kalkulačka krátce, trénink v jednotném čísle
RedirectMatch 301 (?i)^/academy/?$              https://martinbarna.cz/akademie/
RedirectMatch 301 (?i)^/kalkulacka/?$           https://martinbarna.cz/kalkulacka-kalorii-a-makrozivin/
RedirectMatch 301 (?i)^/trenink/?$              https://martinbarna.cz/treninky
# /plan/ bez podstránky nemá index (vracel 403) → rozcestník nástrojů
RedirectMatch 301 ^/plan/?$                     https://martinbarna.cz/nastroje-zdarma/
# staré WP články, které se nemigrovaly (odkazované jen textem) → blog
RedirectMatch 301 ^/5-mytu-o-cukru/?$                                https://martinbarna.cz/clanky/
RedirectMatch 301 ^/6-duvodu-proc-glykemicky-index-nehraje-roli/?$   https://martinbarna.cz/clanky/
RedirectMatch 301 ^/fakta-o-cukru-layne-norton-phd/?$                https://martinbarna.cz/clanky/
RedirectMatch 301 ^/pravda-o-cukru-a-glykemickem-indexu/?$           https://martinbarna.cz/clanky/
RedirectMatch 301 ^/sacharidy-na-noc-layne-norton-phd/?$             https://martinbarna.cz/clanky/

# --- 5) Komprese + cache (rychlost) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- 6) Bezpečnostní hlavičky (ochrana návštěvníků i webu) ---
<IfModule mod_headers.c>
  # Zákaz „hádání" typu souboru (chrání před útoky přes podvržené soubory)
  Header always set X-Content-Type-Options "nosniff"
  # Web nelze vložit do <iframe> cizí stránky (ochrana proti clickjackingu)
  Header always set X-Frame-Options "SAMEORIGIN"
  # Kolik informací o odkazující stránce se posílá pryč (šetrné k soukromí)
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Web si nenárokuje přístup ke kameře/mikrofonu/poloze
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  # Po prvním HTTPS přístupu prohlížeč rok chodí už jen přes HTTPS
  Header always set Strict-Transport-Security "max-age=31536000" "expr=%{HTTPS} == 'on'"
  # PDF (lead magnety a členské materiály) nemají být v Googlu
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>
